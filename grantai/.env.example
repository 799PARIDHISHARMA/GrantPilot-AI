# Copy this file to .env and fill in your IBM watsonx.ai credentials.
# Never commit the actual .env file to version control.

IBM_API_KEY=your_ibm_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Set WATSONX_URL to the regional endpoint that matches where your IBM Cloud
# account was created. Common values:
#   us-south  →  https://us-south.ml.cloud.ibm.com
#   eu-de     →  https://eu-de.ml.cloud.ibm.com
#   eu-gb     →  https://eu-gb.ml.cloud.ibm.com
#   au-syd    →  https://au-syd.ml.cloud.ibm.com
#   jp-tok    →  https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://eu-de.ml.cloud.ibm.com

# WATSONX_AUTH_URL is auto-derived from WATSONX_URL. Override only if needed.
# WATSONX_AUTH_URL=https://iam.eu-de.bluemix.net/identity/token
